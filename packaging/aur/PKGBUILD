# Maintainer: Haibread <haibread@users.noreply.github.com>

# Requires camembert >= 0.3.0: the man-page and shell-completion generators
# (the `camembert-mangen` and `camembert-completions` helper binaries) landed
# after v0.2.0, and package() installs their output.
#
# Per release, in this order:
#   1. bump pkgver
#   2. set _commit to the commit the tag points at — it is what
#      `camembert --version` reports, and a stale value here means the
#      binary lies about which source built it
#   3. updpkgsums
#   4. makepkg --printsrcinfo > .SRCINFO
# See README.md in this directory.

pkgname=camembert
pkgver=0.3.0
pkgrel=1
_commit=0000000
pkgdesc='Disk usage analyzer that answers the real questions: what grew, what is freeable, what is cold'
arch=('x86_64' 'aarch64')
url='https://github.com/Haibread/camembert'
license=('MIT OR Apache-2.0')
depends=('gcc-libs')
makedepends=('cargo')
# makepkg enables LTO by default, which makes `zstd-sys` compile its bundled
# C library into GCC LTO bitcode; rustc's linker cannot resolve symbols out
# of that, and the build dies on undefined `ZSTD_*` at link time. Only the C
# dependency is affected — Rust's own LTO is a cargo profile setting, which
# this workspace does not enable either way — so the cost is nil. The
# alternative, linking the system zstd, would make dump compatibility depend
# on whichever zstd Arch ships that week.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	# The tarball has no .git, so build.rs would stamp `unknown` into
	# --version; hand it the commit the tag points at instead.
	export CAMEMBERT_GIT_SHA="$_commit"
	cargo build --frozen --release --package camembert
	cargo run --frozen --release --package camembert --bin camembert-mangen -- man
	cargo run --frozen --release --package camembert \
		--bin camembert-completions -- completions
}

check() {
	cd "$pkgname-$pkgver"
	export RUSTUP_TOOLCHAIN=stable
	export CARGO_TARGET_DIR=target
	# Extent-dependent tests guard-skip when the build filesystem has no
	# extents, and the statx engine probes io_uring at runtime with a
	# synchronous fallback, so this is chroot-safe. A failure here is a
	# real one — do not paper over it with `|| true`.
	cargo test --frozen --workspace
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm0755 target/release/"$pkgname" "$pkgdir/usr/bin/$pkgname"

	for page in man/*.1; do
		install -Dm0644 "$page" "$pkgdir/usr/share/man/man1/${page##*/}"
	done

	# Each shell looks in its own directory, under its own naming rule.
	# Arch has no `vendor-completions`: zsh site functions go here.
	install -Dm0644 completions/"$pkgname".bash \
		"$pkgdir/usr/share/bash-completion/completions/$pkgname"
	install -Dm0644 completions/_"$pkgname" \
		"$pkgdir/usr/share/zsh/site-functions/_$pkgname"
	install -Dm0644 completions/"$pkgname".fish \
		"$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"

	install -Dm0644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm0644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"

	# MIT requires the copyright notice to ship with the binary; Apache-2.0
	# requires its own text. Dual-licensed means both travel.
	install -Dm0644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
	install -Dm0644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
